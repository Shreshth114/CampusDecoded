# === LLM Providers ===
LLM_PRIMARY=groq
LLM_FALLBACK=gemini

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# Pick via: python scripts/list_models.py groq
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional; pick via: python scripts/list_models.py gemini
GEMINI_MODEL=

# === Embeddings ===
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Bound ONNX inference memory; changing this does not change the model or chunks.
EMBED_BATCH_SIZE=8

# === Vector DB ===
CHROMA_DIR=./.chroma

# === Retrieval ===
TOP_K=5
# Similarity (1 - cosine_distance). Tune on benchmark. See DECISIONS.md.
CONFIDENCE_THRESHOLD=0.35

# === Cache ===
# Exact-match enabled by default. Semantic match is experimental.
CACHE_THRESHOLD=0.95
CACHE_SEMANTIC_ENABLED=false

# === Generation ===
HYDE_MAX_TOKENS=200
ANSWER_MAX_TOKENS=350

# === Server ===
HOST=127.0.0.1
PORT=8000


# Local operator secret, set a long random value. Never put it in static JavaScript.
ADMIN_API_TOKEN=

# Public personal-workspace PDF limits
PERSONAL_MAX_FILE_MB=30
PERSONAL_MAX_PAGES=200
PERSONAL_MAX_DOCUMENTS=20

# Optional deployment paths; local defaults remain unchanged.
# CAMPUS_DATA_DIR=/tmp/campusdecoded/data
# CAMPUS_STORAGE_MODE=ephemeral
# FASTEMBED_CACHE_PATH=/opt/render/project/src/.cache/fastembed
